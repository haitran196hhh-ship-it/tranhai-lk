#!name=⛔ [KHAI TỬ] Locket_YouTube - ĐÃ KHÓA VĨNH VIỄN
#!desc=⛔ CẢNH BÁO: Module này đã bị tác giả TranHai307 KHÓA VÀ KHAI TỬ VĨNH VIỄN! Mọi tính năng đã bị vô hiệu hóa. Vui lòng chuyển sang sử dụng module chính thức Locket_Only_Cold tại: https://tranhai-lk.onrender.com/Locket_Only_Cold.sgmodule
#!author=TranHai307 (@minhhiep07)
#!system=ios

[Rule]
# Chặn hoàn toàn kết nối Locket và YouTube trên module này để ép chuyển đổi
DOMAIN-SUFFIX,locketcamera.com,REJECT
DOMAIN-SUFFIX,googlevideo.com,REJECT
DOMAIN,api.revenuecat.com,REJECT
DOMAIN,firebaseremoteconfig.googleapis.com,REJECT

[URL Rewrite]
^https?:\/\/.*locketcamera\.com.* https://0.0.0.0 307
^https?:\/\/.*youtubei\.googleapis\.com.* https://0.0.0.0 307

[Host]
api.locketcamera.com = 0.0.0.0
us-central1-locket-4252a.cloudfunctions.net = 0.0.0.0
