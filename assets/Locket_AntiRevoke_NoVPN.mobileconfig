  <key>PayloadOrganization</key>
  <string>MinhHiep08 VIP Network</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>8A1C3D5E-7B9F-4E2A-9D8C-1F0E3B5A7C9D</string>
