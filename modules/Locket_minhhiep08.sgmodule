#!name=Locket Gold & Photobooth AI (TranHai307)
#!desc=Tich hop Full Khung Photobooth, 173 AI Filters & Gold VIP qua Render

[Script]
# 1. Xoa ETag de ep Locket luon tai cau hinh moi nhat
deleteHeader = type=http-request,pattern=^https?:\/\/(api\.revenuecat\.com|firebaseremoteconfig\.googleapis\.com|api\.locketcamera\.com|gateway\.locketcamera\.com)\/.+,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/deleteHeader.js?v=1794378661,timeout=60

# 2. Mo khoa Locket Gold RevenueCat
Locket_Gold = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/Locket_TranHai307.js?v=1794378661,timeout=60

# 3. Nap danh sach Khung Photobooth, AI Filters va bat co chon Filter trong Firebase Remote Config
Locket_RemoteConfig = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/Locket_Unlocked.js?v=1794378661,timeout=60

# 4. Mo khoa trang thai can_select_filter & can_use_filter tren API Locket
Locket_Filter_Req = type=http-request,pattern=^https?:\/\/(api\.locketcamera\.com|gateway\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?!generateFilteredImage).+,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/locket_filter_unlock.js?v=1794378661,timeout=60
Locket_Filter_Resp = type=http-response,pattern=^https?:\/\/(api\.locketcamera\.com|gateway\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?!generateFilteredImage).+,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/locket_filter_unlock.js?v=1794378661,timeout=60

# 5. Dieu huong anh chup Photobooth & AI Filter ve may chu Render
Locket_Photobooth_Req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com|gateway\.locketcamera\.com)\/.*generateFilteredImage.*,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/Locket_Photobooth.js?v=1794378661,timeout=60
Locket_Photobooth_Resp = type=http-response,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com|gateway\.locketcamera\.com|tranhai-lk\.onrender\.com)\/.*generateFilteredImage.*,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/Locket_Photobooth.js?v=1794378661,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, gateway.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, *.cloudfunctions.net, tranhai-lk.onrender.com

