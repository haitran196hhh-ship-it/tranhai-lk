  <string>com.locketgold.fullai.config</string>
  <key>PayloadOrganization</key>
  <string>King of Locket Gold VIP</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>7EFC14CA-B59F-4BAD-B487-0C4FC0C4D3F4</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadContent</key>
  <array>

