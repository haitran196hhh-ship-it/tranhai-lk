[MITM]
hostname = %APPEND%, *.xiuxiu.meitu.com, api-sub.meitu.com, meitudata.com, meitu.com

[Script]
Meitu = type=http-response,pattern=^https?:\/\/([^/]+\.)?meitu\.com\/.*/(vip|user|account|h5)\/?,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/tranhai-lk/main/js/MeiTuXiuXiu.js
